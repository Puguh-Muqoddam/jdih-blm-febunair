# ==============================================================================
# JDIH BLM FEB UNAIR - Environment Variables Template
# Salin file ini menjadi `.env` untuk pengembangan lokal.
# ==============================================================================

# Database Connection (Supabase Session Pooler port 5432)
# Format: postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Koneksi lokal Hyperdrive untuk OpenNext / Cloudflare Dev
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase Auth & Storage API
NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<SUPABASE_ANON_KEY>"
SUPABASE_SERVICE_ROLE_KEY="<SUPABASE_SERVICE_ROLE_KEY>"

# Hak Akses Pengelola
ADMIN_EMAILS="puguhmuqoddam151@gmail.com"

# URL Publik Situs
NEXT_PUBLIC_SITE_URL="https://jdih-blm.workers.dev"

# Cloudflare Turnstile (Anti-Bot CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAA..."

# Salt untuk enkripsi IP hashing pada rate limiting
IP_HASH_SALT="ganti_dengan_random_salt_panjang_minimal_32_karakter"
