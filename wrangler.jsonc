{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jdih-blm-febunair",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Domain kustom
  "routes": [
    { "pattern": "jdih-blm-febunair.my.id", "custom_domain": true },
    { "pattern": "www.jdih-blm-febunair.my.id", "custom_domain": true }
  ],
  // Binding database Hyperdrive -> Supabase
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "80dfc667eaa84b4dae9b979ab999ce9e"
      // Untuk dev lokal, JANGAN tulis connection string di sini. Setel di .env:
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://...
    }
  ],
  // Penyimpanan file PDF produk hukum di Cloudflare R2
  // Aktifkan setelah bucket dibuat di Cloudflare: npx wrangler r2 bucket create jdih-blm-docs
  // "r2_buckets": [
  //   { "binding": "DOCS_BUCKET", "bucket_name": "jdih-blm-docs" }
  // ],
  // Pertahankan variabel di Cloudflare Dashboard saat deployment
  "keep_vars": true,
  "observability": { "enabled": true }
}
